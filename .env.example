# Menga Mos — muhit o'zgaruvchilari. Nusxa oling: cp .env.example .env
# Hech biri majburiy emas — har biri o'rnatilganda mos funksiya "real" bo'ladi.

# --- AI tahlil (Claude vision) ---
ANTHROPIC_API_KEY=
# MENGA_MODEL=claude-opus-4-8

# --- Mahsulot rasmlari (Pinduoduo 多多进宝 / Duoduo Jinbao) ---
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=
PDD_CNY_TO_UZS=1750
# PDD_DELIVERY=2–4 hafta

# --- To'lov ---
PAYME_MERCHANT_ID=
# PAYME_ORDER_FIELD=order_id
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=

# --- Try-on / rasmingizda generatsiya ---
# FAQAT shu token kerak — rasmingiz + obraz tavsifi → sizni o'sha kiyimda generatsiya.
REPLICATE_API_TOKEN=
# REPLICATE_TRYON_MODEL=black-forest-labs/flux-kontext-pro
# REPLICATE_IMAGE_FIELD=input_image
# Ixtiyoriy: Pinduoduo kiyim rasmi bilan IDM-VTON rejimi
# REPLICATE_VTON_MODEL=cuuupid/idm-vton

